# Normalise line endings so macOS and Windows contributors produce identical diffs.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.mp4 binary
*.mov binary
*.webm binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.glb binary
