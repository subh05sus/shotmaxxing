{
  "name": "shotmaxxing",
  "private": true,
  "description": "Open-source screen recorder and studio editor for demos, drivable by people and AI agents.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @shotmaxxing/desktop dev",
    "build": "pnpm --filter @shotmaxxing/desktop build",
    "check": "pnpm --filter @shotmaxxing/desktop check",
    "lint": "node scripts/design-guard.mjs && prettier --check .",
    "format": "prettier --write .",
    "tauri": "pnpm --filter @shotmaxxing/desktop tauri",
    "bundle": "node scripts/build-cli-sidecar.mjs && pnpm --filter @shotmaxxing/desktop tauri build --config src-tauri/tauri.release.conf.json",
    "icons": "node scripts/build-icons.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.1.1"
  }
}
